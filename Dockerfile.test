# Dockerfile for test runner
FROM rust:1.78-slim-bookworm AS builder

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    curl \
    awscli \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install cargo-nextest for faster test runs
RUN cargo install cargo-nextest --locked

# Set working directory
WORKDIR /workspace

# Copy Cargo.toml and Cargo.lock for dependency caching
COPY Cargo.toml Cargo.lock ./
COPY crates/*/Cargo.toml crates/*/Cargo.toml

# Build dependencies (dummy build to cache)
RUN mkdir -p crates/kp-bin/src && echo "fn main() {}" > crates/kp-bin/src/main.rs
RUN cargo build --workspace --release 2>/dev/null || true

# Copy source code
COPY . .

# Build test binaries
RUN cargo test --workspace --no-run --release

# ============================================================
# Test runner stage
# ============================================================
FROM debian:bookworm-slim AS test-runner

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    awscli \
    jq \
    netcat-openbsd \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Copy built artifacts
COPY --from=builder /workspace/target/release /workspace/target/release
COPY --from=builder /workspace/target/release/deps /workspace/target/release/deps
COPY --from=builder /workspace/test-scenarios /workspace/test-scenarios

WORKDIR /workspace

# Set library path
ENV LD_LIBRARY_PATH=/workspace/target/release/deps

# Default command runs integration tests
ENTRYPOINT ["cargo", "test", "--test", "integration", "--", "--nocapture"]