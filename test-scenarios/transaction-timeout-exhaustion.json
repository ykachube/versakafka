{
  "name": "transaction-timeout-exhaustion",
  "description": "Transactional producer ID exhausted or transaction times out, proxy should handle gracefully",
  "seed": 13001,
  "duration_seconds": 120,
  "load": {
    "rate_per_sec": 2000,
    "record_size_bytes": 512,
    "topic": "test-topic-txn",
    "partitions": 6,
    "key_distribution": "uniform",
    "transactional": true,
    "transaction_timeout_ms": 5000
  },
  "failure_injection": [
    {
      "at_seconds": 20,
      "type": "toxiproxy",
      "target": "kafka-primary",
      "scenario": "kafka-primary-latency"
    },
    {
      "at_seconds": 40,
      "type": "broker_kill",
      "target": "kafka-1",
      "duration_seconds": 10
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "transactions_aborted_or_committed": true,
    "no_hanging_transactions": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "transaction_state_consistent"
  ]
}