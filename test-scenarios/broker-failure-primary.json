{
  "name": "broker-failure-primary",
  "description": "Primary broker fails under load, traffic should route to secondary or spill",
  "seed": 12345,
  "duration_seconds": 60,
  "load": {
    "rate_per_sec": 1000,
    "record_size_bytes": 1024,
    "topic": "test-topic",
    "partitions": 6,
    "key_distribution": "uniform"
  },
  "failure_injection": {
    "at_seconds": 15,
    "type": "toxiproxy",
    "target": "kafka-primary",
    "scenario": "kafka-primary-unavailable"
  },
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I5": true,
    "max_added_latency_p99_ms": 100,
    "zero_data_loss": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "breaker_opened",
    "spill_activated_or_secondary_used"
  ]
}