{
  "name": "rebalance-during-produce",
  "description": "Consumer group rebalance occurs during active produce, proxy should handle partition reassignment",
  "seed": 22001,
  "duration_seconds": 180,
  "load": {
    "rate_per_sec": 2000,
    "record_size_bytes": 1024,
    "topic": "test-topic-rebalance",
    "partitions": 12,
    "key_distribution": "uniform"
  },
  "failure_injection": [
    {
      "at_seconds": 20,
      "type": "consumer_rebalance",
      "target": "consumer-group",
      "trigger": "member_join"
    },
    {
      "at_seconds": 60,
      "type": "consumer_rebalance",
      "target": "consumer-group",
      "trigger": "member_leave"
    },
    {
      "at_seconds": 100,
      "type": "partition_reassign",
      "target": "kafka-1",
      "topic": "test-topic-rebalance"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "no_misdirected_produces_during_rebalance": true,
    "partition_ownership_consistent": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "produce_partition_consistency"
  ]
}