{
  "name": "s3-multipart-upload-failures",
  "description": "S3 multipart uploads fail partially, proxy should retry and complete",
  "seed": 18001,
  "duration_seconds": 180,
  "load": {
    "rate_per_sec": 3000,
    "record_size_bytes": 4096,
    "topic": "test-topic-s3-multi",
    "partitions": 6,
    "key_distribution": "uniform",
    "ack_policy": "all-or-spill"
  },
  "failure_injection": [
    {
      "at_seconds": 15,
      "type": "toxiproxy",
      "target": "minio",
      "scenario": "minio-slow-upload"
    },
    {
      "at_seconds": 45,
      "type": "toxiproxy",
      "target": "minio",
      "scenario": "minio-5xx-errors"
    },
    {
      "at_seconds": 90,
      "type": "toxiproxy",
      "target": "minio",
      "scenario": "minio-unavailable"
    },
    {
      "at_seconds": 120,
      "type": "toxiproxy",
      "target": "minio",
      "scenario": "minio-recover"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "multipart_uploads_completed": true,
    "no_orphaned_parts": true,
    "manifest_consistent": true
  },
  "checks": [
    "ledger_matches_channels_and_spill",
    "event_ids_consistent",
    "no_duplicate_acks",
    "spill_segments_complete",
    "manifest_valid"
  ]
}