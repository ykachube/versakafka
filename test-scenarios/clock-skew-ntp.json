{
  "name": "clock-skew-ntp",
  "description": "System clock skew affects timestamps, event IDs, and leader election",
  "seed": 29001,
  "duration_seconds": 180,
  "load": {
    "rate_per_sec": 2000,
    "record_size_bytes": 1024,
    "topic": "test-topic-clock-skew",
    "partitions": 6,
    "key_distribution": "uniform",
    "event_id_mode": "generate-uuidv7"
  },
  "failure_injection": [
    {
      "at_seconds": 20,
      "type": "clock_skew",
      "target": "proxy",
      "skew_ms": 5000
    },
    {
      "at_seconds": 60,
      "type": "clock_skew",
      "target": "kafka-1",
      "skew_ms": -3000
    },
    {
      "at_seconds": 120,
      "type": "ntp_sync",
      "target": "all"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "uuidv7_ordering_preserved": true,
    "leader_election_stable": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "timestamp_monotonicity",
    "leader_stability"
  ]
}