{
  "name": "event-id-collision-deterministic",
  "description": "Event ID collision in deterministic mode with non-idempotent producer fallback",
  "seed": 20001,
  "duration_seconds": 120,
  "load": {
    "rate_per_sec": 5000,
    "record_size_bytes": 1024,
    "topic": "test-topic-eid-collision",
    "partitions": 6,
    "key_distribution": "uniform",
    "event_id_mode": "deterministic"
  },
  "failure_injection": [
    {
      "at_seconds": 10,
      "type": "producer_retry",
      "target": "client",
      "retry_count": 3
    },
    {
      "at_seconds": 30,
      "type": "non_idempotent_producer",
      "target": "client"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I3": true,
    "deterministic_id_stable_on_retry": true,
    "fallback_to_uuidv7_on_non_idempotent": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "deterministic_id_reproducibility",
    "uuidv7_fallback_verified"
  ]
}