{
  "name": "combined-chaos",
  "description": "Multiple simultaneous failures: broker down, slow secondary, S3 issues, ARC flapping",
  "seed": 90123,
  "duration_seconds": 300,
  "load": {
    "rate_per_sec": 3000,
    "record_size_bytes": 2048,
    "topic": "test-topic-combined",
    "partitions": 12,
    "key_distribution": "uniform",
    "ack_policy": "all-or-spill"
  },
  "failure_injection": [
    {
      "at_seconds": 15,
      "type": "toxiproxy",
      "target": "kafka-primary",
      "scenario": "kafka-primary-unavailable"
    },
    {
      "at_seconds": 20,
      "type": "toxiproxy",
      "target": "kafka-secondary",
      "scenario": "kafka-primary-latency"
    },
    {
      "at_seconds": 30,
      "type": "toxiproxy",
      "target": "minio",
      "scenario": "minio-5xx-errors"
    },
    {
      "at_seconds": 40,
      "type": "fake_arc",
      "target": "fake-arc",
      "scenario": "arc-flapping"
    },
    {
      "at_seconds": 120,
      "type": "toxiproxy",
      "target": "kafka-primary",
      "scenario": "kafka-primary-recover"
    },
    {
      "at_seconds": 150,
      "type": "toxiproxy",
      "target": "minio",
      "scenario": "minio-recover"
    },
    {
      "at_seconds": 180,
      "type": "fake_arc",
      "target": "fake-arc",
      "scenario": "arc-all-healthy"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I4": true,
    "invariant_I5": true,
    "invariant_I6": true,
    "invariant_I7": true,
    "invariant_I8": true,
    "all_invariants_hold": true
  },
  "checks": [
    "ledger_matches_all_stores",
    "event_ids_consistent_across_channels",
    "no_duplicate_acks",
    "ordering_violations_documented",
    "spill_replayed_correctly",
    "reconciler_detects_gaps",
    "breaker_state_logged"
  ]
}