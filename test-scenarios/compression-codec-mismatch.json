{
  "name": "compression-codec-mismatch",
  "description": "Producer uses unsupported compression codec, proxy should handle or reject",
  "seed": 28001,
  "duration_seconds": 120,
  "load": {
    "rate_per_sec": 2000,
    "record_size_bytes": 1024,
    "topic": "test-topic-compression",
    "partitions": 6,
    "key_distribution": "uniform",
    "compression": "zstd"
  },
  "failure_injection": {
    "at_seconds": 10,
    "type": "broker_config_change",
    "target": "kafka-1",
    "compression_codecs": ["gzip", "snappy", "lz4"]
  },
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "codec_rejection_handled": true,
    "fallback_compression_works": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "unsupported_codec_error"
  ]
}