{
  "name": "wal-disk-io-errors",
  "description": "WAL disk experiences I/O errors (torn writes, fsync failures), proxy should handle gracefully",
  "seed": 17001,
  "duration_seconds": 120,
  "load": {
    "rate_per_sec": 2000,
    "record_size_bytes": 1024,
    "topic": "test-topic-wal-io",
    "partitions": 6,
    "key_distribution": "uniform",
    "ack_policy": "all-or-spill"
  },
  "failure_injection": [
    {
      "at_seconds": 10,
      "type": "fs_failure",
      "target": "wal",
      "scenario": "torn-write"
    },
    {
      "at_seconds": 30,
      "type": "fs_failure",
      "target": "wal",
      "scenario": "fsync-failure"
    },
    {
      "at_seconds": 60,
      "type": "fs_failure",
      "target": "wal",
      "scenario": "disk-full"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I7": true,
    "wal_recovery_on_restart": true,
    "no_acknowledged_loss": true
  },
  "checks": [
    "ledger_matches_wal_and_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "wal_checksum_validation",
    "backpressure_activated"
  ]
}