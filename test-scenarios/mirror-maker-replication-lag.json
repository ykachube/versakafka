{
  "name": "mirror-maker-replication-lag",
  "description": "MirrorMaker replication lag spikes, secondary channel falls behind",
  "seed": 24001,
  "duration_seconds": 180,
  "load": {
    "rate_per_sec": 5000,
    "record_size_bytes": 1024,
    "topic": "test-topic-mm-lag",
    "partitions": 12,
    "key_distribution": "uniform",
    "ack_policy": "primary-sync-secondary-async"
  },
  "failure_injection": [
    {
      "at_seconds": 15,
      "type": "toxiproxy",
      "target": "kafka-secondary",
      "scenario": "kafka-primary-latency"
    },
    {
      "at_seconds": 45,
      "type": "toxiproxy",
      "target": "kafka-secondary",
      "scenario": "kafka-primary-bandwidth"
    },
    {
      "at_seconds": 90,
      "type": "toxiproxy",
      "target": "kafka-secondary",
      "scenario": "kafka-primary-recover"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I5": true,
    "primary_latency_unaffected": true,
    "replication_catches_up": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "primary_channel_latency_p99",
    "secondary_lag_recovery_time"
  ]
}