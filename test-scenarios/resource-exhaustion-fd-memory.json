{
  "name": "resource-exhaustion-fd-memory",
  "description": "File descriptor exhaustion and memory pressure, proxy should activate backpressure",
  "seed": 30001,
  "duration_seconds": 180,
  "load": {
    "rate_per_sec": 10000,
    "record_size_bytes": 1024,
    "topic": "test-topic-resource",
    "partitions": 24,
    "key_distribution": "uniform"
  },
  "failure_injection": [
    {
      "at_seconds": 10,
      "type": "resource_limit",
      "target": "proxy",
      "max_fds": 1000,
      "max_memory_mb": 512
    },
    {
      "at_seconds": 60,
      "type": "resource_limit",
      "target": "proxy",
      "max_fds": 500,
      "max_memory_mb": 256
    },
    {
      "at_seconds": 120,
      "type": "resource_recover",
      "target": "proxy"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I7": true,
    "backpressure_activated": true,
    "oom_prevented": true,
    "fd_exhaustion_handled": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "memory_usage_bounded",
    "fd_usage_bounded",
    "recovery_after_limits_removed"
  ]
}