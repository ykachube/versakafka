{
  "name": "metadata-cache-staleness",
  "description": "Metadata cache becomes stale due to broker changes, proxy should refresh",
  "seed": 14001,
  "duration_seconds": 180,
  "load": {
    "rate_per_sec": 1000,
    "record_size_bytes": 1024,
    "topic": "test-topic-meta",
    "partitions": 6,
    "key_distribution": "uniform"
  },
  "failure_injection": [
    {
      "at_seconds": 15,
      "type": "broker_add",
      "target": "kafka-1",
      "new_broker": "kafka-4"
    },
    {
      "at_seconds": 60,
      "type": "broker_remove",
      "target": "kafka-2"
    },
    {
      "at_seconds": 120,
      "type": "partition_reassign",
      "target": "kafka-1",
      "topic": "test-topic-meta"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "metadata_refreshed_within_ms": 5000,
    "no_misdirected_produces": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "metadata_version_monotonic"
  ]
}