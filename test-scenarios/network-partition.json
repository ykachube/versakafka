{
  "name": "network-partition",
  "description": "Network partition between proxy and primary cluster, then recovery",
  "seed": 23456,
  "duration_seconds": 120,
  "load": {
    "rate_per_sec": 500,
    "record_size_bytes": 2048,
    "topic": "test-topic",
    "partitions": 6,
    "key_distribution": "uniform"
  },
  "failure_injection": [
    {
      "at_seconds": 20,
      "type": "toxiproxy",
      "target": "kafka-primary",
      "scenario": "kafka-primary-latency"
    },
    {
      "at_seconds": 40,
      "type": "toxiproxy",
      "target": "kafka-primary",
      "scenario": "kafka-primary-timeout"
    },
    {
      "at_seconds": 80,
      "type": "toxiproxy",
      "target": "kafka-primary",
      "scenario": "kafka-primary-recover"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I5": true,
    "max_added_latency_p99_ms": 500,
    "recovery_without_data_loss": true
  },
  "checks": [
    "ledger_matches_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "breaker_opened_and_closed",
    "spill_replayed_after_recovery"
  ]
}