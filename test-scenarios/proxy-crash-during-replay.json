{
  "name": "proxy-crash-during-replay",
  "description": "Proxy crashes during spill replay, should resume from last checkpoint",
  "seed": 78901,
  "duration_seconds": 180,
  "load": {
    "rate_per_sec": 1000,
    "record_size_bytes": 1024,
    "topic": "test-topic-replay",
    "partitions": 6,
    "key_distribution": "uniform",
    "ack_policy": "all-or-spill"
  },
  "failure_injection": [
    {
      "at_seconds": 10,
      "type": "toxiproxy",
      "target": "kafka-primary",
      "scenario": "kafka-primary-unavailable"
    },
    {
      "at_seconds": 60,
      "type": "process_kill",
      "target": "proxy",
      "signal": "SIGKILL"
    },
    {
      "at_seconds": 65,
      "type": "process_restart",
      "target": "proxy"
    }
  ],
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I8": true,
    "replay_resumes_from_checkpoint": true,
    "no_duplicate_replay": true
  },
  "checks": [
    "ledger_matches_channels_and_spill",
    "event_ids_consistent",
    "no_duplicate_acks",
    "replay_position_checkpointed",
    "graceful_drain_on_sigterm_not_sigkill"
  ]
}