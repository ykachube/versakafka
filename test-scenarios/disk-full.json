{
  "name": "disk-full",
  "description": "Disk fills up, backpressure should activate without losing acknowledged records",
  "seed": 67890,
  "duration_seconds": 60,
  "load": {
    "rate_per_sec": 5000,
    "record_size_bytes": 4096,
    "topic": "test-topic-disk",
    "partitions": 12,
    "key_distribution": "uniform"
  },
  "failure_injection": {
    "at_seconds": 5,
    "type": "fs_failure",
    "target": "wal",
    "scenario": "disk-full"
  },
  "expected": {
    "invariant_I1": true,
    "invariant_I7": true,
    "backpressure_activated": true,
    "no_acknowledged_loss": true,
    "producer_blocked_or_errors": true
  },
  "checks": [
    "ledger_matches_wal_and_channels",
    "event_ids_consistent",
    "no_duplicate_acks",
    "backpressure_metrics_recorded",
    "producer_receives_retriable_errors"
  ]
}