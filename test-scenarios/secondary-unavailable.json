{
  "name": "secondary-unavailable",
  "description": "Secondary cluster unavailable, primary should handle load with spill",
  "seed": 45678,
  "duration_seconds": 90,
  "load": {
    "rate_per_sec": 1500,
    "record_size_bytes": 1024,
    "topic": "test-topic-dual",
    "partitions": 6,
    "key_distribution": "uniform",
    "ack_policy": "primary-sync-secondary-async"
  },
  "failure_injection": {
    "at_seconds": 15,
    "type": "toxiproxy",
    "target": "kafka-secondary",
    "scenario": "kafka-primary-unavailable"
  },
  "expected": {
    "invariant_I1": true,
    "invariant_I2": true,
    "invariant_I5": true,
    "primary_latency_p99_ms": 50,
    "spill_activated": true
  },
  "checks": [
    "ledger_matches_channels_and_spill",
    "event_ids_consistent",
    "no_duplicate_acks",
    "spill_contains_unacked_records",
    "primary_channel_healthy"
  ]
}